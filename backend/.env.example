GROQ_API_KEY=your_groq_api_key_here
GROQ_TRIAGE_MODEL=openai/gpt-oss-20b
GROQ_DIAGNOSIS_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
PORT=5000
MAX_TURNS=5
MAX_SESSION_TURNS=20
MAX_MESSAGE_CHARS=2000
SESSION_TTL_MS=3600000
MAX_SESSIONS=1000
GROQ_MAX_TOKENS=700
MAX_IMAGE_BYTES=4194304
MECHANIC_RADIUS_M=15000
MECHANIC_LIMIT=3
MECHANIC_CACHE_TTL_MS=300000
EXTERNAL_TIMEOUT_MS=10000
EXTERNAL_MAX_RETRIES=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
ALLOWED_ORIGINS=http://localhost:5173
# Required to enable the public Nominatim fallback. Use a real monitored address.
OSM_CONTACT_EMAIL=you@example.com
